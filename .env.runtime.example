RUNTIME_DATABASE_URL=postgresql://runtime:CHANGE_ME@runtime-db:5432/kezek_runtime
RUNTIME_PORT=3001
HOST=0.0.0.0
RUNTIME_ORIGINS=http://localhost:3001
COOKIE_SECURE=false
INSTALLATION_ID=
INSTALLATION_TIMEZONE=Asia/Qyzylorda
SETUP_SECRET=
CONTROL_PUBLIC_KEY_FILE=/run/secrets/control_public
UPDATE_PUBLIC_KEY_FILE=/run/secrets/release_public
BRIDGE_URL=
BRIDGE_TOKEN=
PRIVACY_MODE=isolated
MAINTENANCE_ENABLED=false
UPDATE_DIRECTORY=/app/.local/updates
GITHUB_REPOSITORY=
GITHUB_READ_TOKEN=

# Explicit opt-in for signed, audited 30-minute platform owner sessions
ALLOW_OWNER_ACCESS=false

# Configure service hooks only after a staging rehearsal; see docs/UPDATES.md.
RUNTIME_CONFIG_FILE=
PG_DUMP_PATH=pg_dump
UPDATE_CURRENT_LINK=
UPDATE_STOP_SCRIPT=
UPDATE_START_SCRIPT=
UPDATE_HEALTH_URL=http://127.0.0.1:3001/api/health
UPDATE_APP_ROLLBACK_SAFE=false
UPDATE_ALLOW_OUTSIDE_WINDOW=false
